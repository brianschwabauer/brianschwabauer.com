{
	"name": "brianschwabauer",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "concurrently -n site,images -c cyan,magenta \"pnpm dev:site\" \"pnpm dev:images\"",
		"dev:all": "pnpm dev",
		"dev:site": "vite dev",
		"dev:images": "DOCKER_HOST=${DOCKER_HOST:-unix:///var/run/docker.sock} wrangler dev --config wrangler.images.jsonc --persist-to .wrangler/state",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo --watch",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.115.0",
		"@auth/core": "^0.41.3",
		"@auth/sveltekit": "^1.11.3",
		"@cloudflare/containers": "^0.3.7",
		"@delightstack/components": "^1.4.1",
		"@delightstack/images": "^1.0.1",
		"@delightstack/styles": "^1.1.0",
		"@delightstack/utilities": "^1.0.1",
		"@orama/orama": "^3.1.18",
		"@resvg/resvg-wasm": "^2.6.2",
		"@tiptap/core": "^3.29.2",
		"@tiptap/extension-heading": "^3.29.2",
		"@tiptap/extension-link": "^3.29.2",
		"@tiptap/pm": "^3.29.2",
		"@tiptap/starter-kit": "^3.29.2",
		"hls.js": "^1.6.16",
		"mediabunny": "^1.52.3",
		"satori": "^0.29.0",
		"thumbhash": "^0.1.1"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260804.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@typescript/native": "npm:typescript@7.0.2",
		"concurrently": "^10.0.4",
		"oxfmt": "^0.62.0",
		"oxlint": "^1.77.0",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"typescript": "^6.0.3",
		"vite": "^8.2.0",
		"wrangler": "^4.118.0"
	},
	"packageManager": "pnpm@11.3.0"
}
