{
	"name": "brianschwabauer",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "concurrently -n site,images -c cyan,magenta \"pnpm dev:site\" \"pnpm dev:images\"",
		"dev:all": "pnpm dev",
		"dev:site": "vite dev",
		"dev:images": "DOCKER_HOST=${DOCKER_HOST:-unix:///var/run/docker.sock} wrangler dev --config wrangler.images.toml --persist-to .wrangler/state",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.32.1",
		"@auth/core": "^0.37.4",
		"@auth/sveltekit": "^1.11.3",
		"@cloudflare/containers": "^0.1.1",
		"@delightstack/components": "^1.4.0",
		"@delightstack/images": "^1.0.1",
		"@delightstack/styles": "^1.1.0",
		"@delightstack/utilities": "^1.0.1",
		"@orama/orama": "^3.1.18",
		"@tiptap/core": "^2.27.2",
		"@tiptap/extension-heading": "^2.27.2",
		"@tiptap/extension-link": "^2.27.2",
		"@tiptap/pm": "^2.27.2",
		"@tiptap/starter-kit": "^2.27.2",
		"hls.js": "^1.6.16",
		"mediabunny": "^1.52.3",
		"thumbhash": "^0.1.1"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260702.1",
		"@sveltejs/adapter-cloudflare": "^5.1.0",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"concurrently": "^9.2.4",
		"oxfmt": "^0.52.0",
		"oxlint": "^1.77.0",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"typescript": "^5.9.3",
		"vite": "^6.4.3",
		"wrangler": "^4.118.0"
	},
	"packageManager": "pnpm@11.3.0"
}
